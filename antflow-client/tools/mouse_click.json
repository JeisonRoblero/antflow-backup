{
  "name": "mouse_click",
  "description": "Moves to (x, y) and performs a mouse click (left, right, or middle button).",
  "parameters": {
    "type": "object",
    "properties": {
      "x": { "type": "integer" },
      "y": { "type": "integer" },
      "button": { "type": "string", "enum": ["left", "right", "middle"] },
      "delay_ms": { "type": "integer" }
    },
    "required": ["x", "y"]
  }
}
