{
  "productName": "Antflow",
  "version": "0.1.0",
  "identifier": "com.antflow.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": {
      "script": "node obfuscate.js --prod",
      "cwd": ".."
    },
    "beforeDevCommand": {
      "script": "node obfuscate.js --dev",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antflow",
        "width": 700,
        "height": 130,
        "minWidth": 400,
        "minHeight": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "center": false,
        "x": null,
        "y": null,
        "skipTaskbar": false,
        "visible": true,
        "focus": true,
        "shadow": true,
        "devtools": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' tauri: asset: http://127.0.0.1:* http://localhost:* https://huggingface.co https://*.huggingface.co; img-src 'self' asset: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
